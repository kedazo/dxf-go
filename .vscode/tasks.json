{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "generate",
        "build core"
      ]
    },
    {
      "label": "generate",
      "type": "shell",
      "command": "go generate",
      "problemMatcher": "$go",
      "group": "build"
    },
    {
      "label": "build core",
      "type": "shell",
      "command": "go build",
      "problemMatcher": "$go",
      "group": "build"
    }
  ]
}